        "scene": {
          "x": [-1, 5],
          "y": [-1, 5],
          "vectors": [
            { "p1": [0, 0], "p2": [1, 1], "color": "#5ee6ff", "label": "a" },
            { "p1": [0, 0], "p2": [3, 3], "color": "#ffd479", "label": "b" }
          ]
        },
        "ask": "已知 a=(1,2)，b=(2,4)，则 a 与 b 的关系是？",
        "opts": ["共线（平行）", "垂直", "相等", "既不共线也不垂直"],
        "ans": 0,
        "hint": "检验 x₁y₂−x₂y₁ 是否为 0。",
        "explain": "1×4−2×2=0，两向量共线（且 b=2a）。",
        "success": "对！坐标交叉相减为 0 即共线。"
      },
      {
        "name": "4-2 建构：共线求参",
        "type": "choice",
        "q": "已知 a=(1,2)，b=(2,m)，若 a∥b，则 m =?",
        "opts": ["4", "1", "−4", "2"],
        "ans": 0,
        "hint": "共线条件 x₁y₂−x₂y₁=0。",
        "explain": "1×m−2×2=0，得 m=4。"
      },
      {
        "name": "4-3 迁移：垂直求参",
        "type": "choice",
        "q": "已知 a=(1,2)，b=(2,m)，若 a⊥b，则 m =?",
        "opts": ["−1", "1", "−4", "4"],
        "ans": 0,
        "hint": "垂直即数量积为 0。",
        "explain": "a·b=1×2+2×m=0，得 m=−1。"
      }
    ]
  }
