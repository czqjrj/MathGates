        "hint": "坐标法：a·b=x₁x₂+y₁y₂。",
        "explain": "a·b=4×2+0×2=8。",
        "success": "对！数量积可用坐标直接算，也等于投影乘模长。"
      },
      {
        "name": "3-2 建构：夹角",
        "type": "choice",
        "q": "已知 |a|=1，|b|=2，a·b=1，则 a 与 b 的夹角为？",
        "opts": ["60°", "30°", "90°", "120°"],
        "ans": 0,
        "hint": "cosθ=(a·b)/(|a||b|)。",
        "explain": "cosθ=1/(1×2)=1/2，故夹角为 60°。"
      },
      {
        "name": "3-3 迁移：垂直条件",
        "type": "choice",
        "q": "已知 a=(1,2)，b=(x,−1)，若 a⊥b，则 x =?",
        "opts": ["2", "−2", "1", "−1"],
        "ans": 0,
        "hint": "垂直 ⇔ a·b=0。",
        "explain": "a·b=x−2=0，得 x=2。"
      }
    ]
  },
  "vec_collinear": {
    "title": "平面向量",
