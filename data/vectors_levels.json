        "hint": "先数乘再相加。",
        "explain": "2a=(4,6)，2a+b=(4−1,6+1)=(3,7)。"
      },
      {
        "name": "2-3 迁移：模长",
        "type": "choice",
        "q": "已知 a=(3,4)，则 |a| =?",
        "opts": ["5", "7", "25", "1"],
        "ans": 0,
        "hint": "|a|=√(x²+y²)。",
        "explain": "|a|=√(3²+4²)=5。"
      }
    ]
