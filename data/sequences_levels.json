  "seq_split": {
    "title": "数列",
    "method": "裂项相消求和",
    "color": "#FF99C3",
    "summary": "把通项拆成两项之差，求和时中间项相互抵消。",
    "levels": [
      {
        "name": "5-1 实验：中间项消失",
        "type": "explore",
        "q": "1/(n(n+1))=1/n−1/(n+1)，求和时中间项成对抵消，只剩首尾。",
        "scene": {
          "x": [-1, 6],
          "y": [-0.2, 1.2],
          "scatter": [[1, 0.5], [2, 0.6667], [3, 0.75], [4, 0.8], [5, 0.8333]],
          "scatter_guide": true,
          "scatter_color": "#5ee6ff"
        },
        "ask": "1/(1×2) =?",
        "opts": ["1/1 − 1/2", "1/2 − 1/3", "1/1 + 1/2", "1/2"],
        "ans": 0,
        "hint": "1/(n(n+1))=1/n−1/(n+1)，取 n=1。",
        "explain": "1/(1×2)=1−1/2=1/2。",
        "success": "对！裂项后中间项会成对消去。"
      },
      {
        "name": "5-2 建构：部分和",
        "type": "choice",
        "q": "1/(1×2)+1/(2×3)+…+1/(n(n+1)) =?",
        "opts": ["1−1/(n+1)", "1−1/n", "1/(n+1)", "n/(n+1)+1"],
        "ans": 0,
        "hint": "裂项后只剩第一项与最后一项。",
        "explain": "Sₙ=(1−1/2)+(1/2−1/3)+…+(1/n−1/(n+1))=1−1/(n+1)。"
      },
      {
        "name": "5-3 迁移：求极限",
        "type": "choice",
        "q": "当 n→+∞ 时，Sₙ=1−1/(n+1) 趋于？",
        "opts": ["1", "0", "+∞", "1/2"],
        "ans": 0,
        "hint": "1/(n+1) 趋于 0。",
        "explain": "n→∞ 时 1/(n+1)→0，故 Sₙ→1。"
      }
    ]
  },
