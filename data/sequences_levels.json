    "levels": [
      {
        "name": "1-1 实验：等差的节拍",
        "type": "explore",
        "q": "观察散点图，相邻两点的高度差是否恒定？",
        "scene": {
          "x": [-1, 6],
          "y": [-1, 10],
          "scatter": [[1, 1], [2, 3], [3, 5], [4, 7], [5, 9]],
          "scatter_guide": true,
          "scatter_color": "#FF99C3"
        },
        "ask": "数列 1,3,5,7,… 是等差数列，其公差 d =?",
        "opts": ["2", "1", "3", "−2"],
        "ans": 0,
        "hint": "公差是相邻两项之差。",
        "explain": "3−1=5−3=2，公差 d=2。",
        "success": "对！散点图上等距上升，就是等差数列。"
      },
      {
        "name": "1-2 建构：通项公式",
        "type": "choice",
        "q": "数列 1,3,5,7,… 的通项公式是？",
        "opts": ["aₙ=2n−1", "aₙ=2n+1", "aₙ=n+1", "aₙ=2ⁿ−1"],
        "ans": 0,
        "hint": "首项 a₁=1，公差 d=2。",
        "explain": "aₙ=a₁+(n−1)d=1+2(n−1)=2n−1。"
      },
      {
        "name": "1-3 迁移：等比数列",
        "type": "choice",
        "q": "数列 2,4,8,16,… 的通项公式是？",
        "opts": ["aₙ=2ⁿ", "aₙ=2n", "aₙ=n²", "aₙ=2ⁿ⁻¹"],
        "ans": 0,
        "hint": "公比 q=2，a₁=2。",
        "explain": "aₙ=a₁qⁿ⁻¹=2·2ⁿ⁻¹=2ⁿ。"
      }
    ]
  },
