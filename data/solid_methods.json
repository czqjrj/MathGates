{
  "methods": {
    "complement": {
      "title": "补形法 · 求三棱锥的外接球",
      "method": "补形法",
      "topic": "res://scripts/modules/solid/topics/complement.gd",
      "summary": "三条棱两两垂直 → 补成长方体，体对角线的一半就是外接球半径。",
      "levels": [
        {
          "name": "第 1 关 · 墙角侦察",
          "type": "pick",
          "reveal": 1.4,
          "q": "在三维图中点选从顶点 P 出发、两两互相垂直的三条棱(会高亮)。",
          "hint": "从 P 出发的有 PA、PB、PC 三条。"
        },
        {
          "name": "第 2 关 · 补成长方体",
          "type": "choice",
          "reveal": 2.6,
          "q": "PA=3、PB=4、PC=5 两两垂直，补成的长方体的长宽高是？",
          "opts": [
            "$$2\\times3\\times4$$",
            "$$4\\times5\\times6$$",
            "$$3\\times4\\times5$$",
            "$$3\\times5\\times5$$"
          ],
          "ans": 2,
          "hint": "三条直角棱本身就是长、宽、高。"
        },
        {
          "name": "第 3 关 · 找直径",
          "type": "choice",
          "reveal": 3.4,
          "q": "长方体的外接球，其直径是长方体的哪条线？",
          "opts": [
            "一条棱",
            "某一个面的对角线",
            "体对角线(相对两顶点的连线)"
          ],
          "ans": 2,
          "hint": "球心在长方体中心，直径 = 体对角线。"
        },
        {
          "name": "第 4 关 · 求半径",
          "type": "choice",
          "reveal": 4.7,
          "cam_zoom": 3.0,
          "q": "补成的长方体与三棱锥共用外接球，直径就是体对角线：",
          "formula": "res://art/formulas/fq_complement_diag.png",
          "opts": [
            "$$\\dfrac{5\\sqrt{2}}{2}$$",
            "$$\\sqrt{50}$$",
            "$$5\\sqrt{2}$$",
            "$$\\dfrac{25}{2}$$"
          ],
          "ans": 0,
          "hint": "直径是补成长方体的体对角线，半径再取一半：先算三条棱的平方和再开根。"
        },
        {
          "name": "第 5 关 · 定球心",
          "type": "choice",
          "reveal": 6.0,
          "cam_zoom": 2.7,
          "q": "外接球球心 O 在长方体的什么位置？",
          "opts": [
            "顶点 P",
            "一条棱的中点",
            "长方体中心 (1.5, 2, 2.5)"
          ],
          "ans": 2,
          "hint": "体对角线的中点就是长方体中心。"
        },
        {
          "name": "第 6 关 · 补形法的适用条件",
          "type": "choice",
          "reveal": 6.6,
          "q": "能用「三条棱两两垂直 → 补成长方体求外接球」的关键前提是？",
          "opts": [
            "三条棱两两垂直且共顶点",
            "三条棱长度相等",
            "底面是正三角形",
            "三棱锥是正三棱锥"
          ],
          "ans": 0,
          "hint": "两两垂直的三条棱恰好是长方体的长、宽、高，缺一不可。"
        },
        {
          "name": "第 7 关 · 由棱长直接求半径",
          "type": "choice",
          "reveal": 7.2,
          "q": "三条两两垂直的棱长为 2、4、4，则外接球半径 R = ?",
          "opts": [
            "3",
            "6",
            "√20",
            "4"
          ],
          "ans": 0,
          "hint": "体对角线 = √(长²+宽²+高²)，半径是体对角线的一半。"
        }
      ]
    },
    "vector_sphere": {
      "title": "空间向量法 · 求三棱锥的外接球",
      "method": "坐标法",
      "topic": "res://scripts/modules/solid/topics/vector_sphere.gd",
      "summary": "建系 → 设球心 → 由 OA=OB=OC=OP 列方程，两两相减消去二次项求解。",
      "levels": [
        {
          "name": "第 1 关 · 建立坐标系",
          "type": "choice",
          "reveal": 1.4,
          "q": "以 A 为原点建立空间直角坐标系，四个顶点中哪一个是原点？",
          "opts": [
            "$$A(0,0,0)$$",
            "$$B(4,0,0)$$",
            "$$C(1,3,0)$$",
            "$$P(4,2,4)$$"
          ],
          "ans": 0,
          "hint": "原点的三个坐标分量都是 0，对照选项排除。"
        },
        {
          "name": "第 2 关 · 顶点坐标",
          "type": "choice",
          "reveal": 2.4,
          "q": "点 P 的坐标是？",
          "opts": [
            "$$(4,2,4)$$",
            "$$(2,1,2)$$",
            "$$(1,3,0)$$",
            "$$(0,0,0)$$"
          ],
          "ans": 0,
          "hint": "看图上的坐标标注。"
        },
        {
          "name": "第 3 关 · 列方程",
          "type": "choice",
          "reveal": 3.4,
          "q": "由 OA = OB，两边平方后展开得到：",
          "formula": "res://art/formulas/fq_vector_eq.png",
          "opts": [
            "$$x=1$$",
            "$$x=2$$",
            "$$x=3$$",
            "$$x=4$$"
          ],
          "ans": 1,
          "hint": "两式相减消去平方项，得到只含 x 的一次方程，再解它。"
        },
        {
          "name": "第 4 关 · 求半径",
          "type": "choice",
          "reveal": 4.0,
          "q": "球心 O(2, 1, 2),A(0, 0, 0)，外接球半径 R:",
          "formula": "res://art/formulas/fq_vector_R.png",
          "opts": [
            "2",
            "3",
            "$$\\sqrt{5}$$",
            "$$\\sqrt{8}$$"
          ],
          "ans": 1,
          "hint": "R 就是球心到原点的距离：三个坐标的平方和再开根。"
        },
        {
          "name": "第 5 关 · 球面方程",
          "type": "choice",
          "reveal": 6.75,
          "cam_step": 6,
          "cam_zoom": 2.1,
          "q": "外接球的球面方程是？",
          "opts": [
            "$$(x-2)^{2}+(y-1)^{2}+(z-2)^{2}=9$$",
            "$$(x+2)^{2}+(y+1)^{2}+(z+2)^{2}=9$$",
            "$$(x-2)^{2}+(y-1)^{2}+(z-2)^{2}=3$$",
            "$$(x-2)^{2}+(y-1)^{2}+(z-2)^{2}=81$$"
          ],
          "ans": 0,
          "hint": "球面方程是 (x−a)²+(y−b)²+(z−c)²=R²，把上一关的球心与半径代入。"
        }
      ]
    },
    "geom_sphere": {
      "title": "垂线法 · 求三棱锥的外接球",
      "method": "几何法",
      "topic": "res://scripts/modules/solid/topics/geom_sphere.gd",
      "zoom": 2.5,
      "summary": "底面外心 O′ → 过 O′ 作垂线 l → R² = r² + h²，由 OA=OP 解 h 求 R。",
      "levels": [
        {
          "name": "第 1 关 · 找球心所在直线",
          "type": "choice",
          "reveal": 1.9,
          "q": "一条棱垂直底面时，外接球球心 O 一定在哪条线上？",
          "opts": [
            "过底面外心 O′ 且垂直底面的直线 l",
            "任意一条直线",
            "底面的一条边",
            "过 A 点的侧棱"
          ],
          "ans": 0,
          "hint": "球心在底面的射影就是外心 O′。"
        },
        {
          "name": "第 2 关 · 底面外接圆半径",
          "type": "choice",
          "reveal": 2.7,
          "q": "底面外接圆半径 r 由正弦定理确定：",
          "formula": "res://art/formulas/fq_geom_sine.png",
          "opts": [
            "$$\\sqrt{13}$$",
            "$$2\\sqrt{3}$$",
            "$$\\sqrt{10}$$",
            "$$\\dfrac{13}{2}$$"
          ],
          "ans": 0,
          "hint": "正弦定理 r = a / (2sin A)，把底面的边与角代进去。"
        },
        {
          "name": "第 3 关 · 求高度 h",
          "type": "choice",
          "reveal": 3.8,
          "q": "由 OA = OP 解得 OO′ = h = ?",
          "opts": [
            "4",
            "6",
            "8",
            "12"
          ],
          "ans": 1,
          "hint": "球心在过底面外心的垂线上，由 OA = OP 列方程解出 h。"
        },
        {
          "name": "第 4 关 · 求半径 R",
          "type": "choice",
          "reveal": 5.3,
          "cam_step": 5,
          "cam_zoom": 3.6,
          "q": "在 Rt△OO′A 中，求外接球半径 R:",
          "formula": "res://art/formulas/fq_geom_R.png",
          "opts": [
            "5",
            "6",
            "7",
            "$$\\sqrt{13}$$"
          ],
          "ans": 2,
          "hint": "在 Rt△OO′A 中用勾股定理：R² = r² + OO′²，最后取正根。"
        },
        {
          "name": "第 5 关 · 易错点",
          "type": "choice",
          "reveal": 7.35,
          "cam_step": 7,
          "cam_zoom": 2.5,
          "q": "钝角三角形的外心在？",
          "opts": [
            "三角形内部",
            "三角形外部",
            "一条边上",
            "顶点处"
          ],
          "ans": 1,
          "hint": "先画出外接圆，观察圆心落在三角形内部还是外部。"
        }
      ]
    },
