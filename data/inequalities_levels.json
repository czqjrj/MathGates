    "levels": [
      {
        "name": "2-1 实验：和的最小值",
        "type": "explore",
        "q": "观察 y=x 与 y=1/x 的图像，当 x>0 时它们的和何时最小？",
        "scene": {
          "x": [-1, 5],
          "y": [-1, 5],
          "curves": [
            { "fn": "linear", "a": 1, "color": "#5ee6ff", "label": "y=x" },
            { "fn": "recip", "a": 1, "color": "#ffd479", "label": "y=1/x" }
          ],
          "points": [{ "p": [1, 1], "color": "#f2637b", "label": "x=1" }]
        },
        "ask": "若 x>0，则 x+1/x 的最小值是？",
        "opts": ["2", "1", "0", "4"],
        "ans": 0,
        "hint": "基本不等式 a+b≥2√(ab)，当且仅当两数相等时取等。",
        "explain": "x+1/x≥2√(x·1/x)=2，当 x=1 时取等号。",
        "success": "对！和的最小值在 x=1/x 即 x=1 时取得。"
      },
      {
        "name": "2-2 建构：配凑应用",
        "type": "choice",
        "q": "当 x>0 时，x+4/x 的最小值是？",
        "opts": ["4", "2", "8", "5"],
        "ans": 0,
        "hint": "x·(4/x)=4，和为定值时最小 = 2√4。",
        "explain": "x+4/x≥2√4=4，当 x=2 时取到。"
      },
      {
        "name": "2-3 迁移：1 的代换",
        "type": "choice",
        "q": "若 a>0，b>0 且 a+b=1，则 1/a+1/b 的最小值是？",
        "opts": ["4", "2", "3", "1"],
        "ans": 0,
        "hint": "1/a+1/b=(a+b)(1/a+1/b)=2+a/b+b/a。",
        "explain": "1/a+1/b=2+(a/b+b/a)≥2+2=4，当 a=b=1/2 时取到。"
      }
    ]
  }
