  "lore": [
    {
      "id": "seq",
      "title": "碑文·归序",
      "text": "万物流转皆有其序，离散之间，自见通项。"
    },
    {
      "id": "solid",
      "title": "碑文·筑形",
      "text": "平面不足立物，便向上升起一维，形体自会闭合。"
    },
    {
      "id": "conic",
      "title": "碑文·弧光",
      "text": "一束光斜切圆锥，弧线便得有了名字。"
    },
    {
      "id": "line",
      "title": "碑文·直轨",
      "text": "两点定其向，一点与斜率定其形。"
    },
    {
      "id": "space",
      "title": "碑文·维度",
      "text": "给每个方向一个坐标，空间便不再幽深难测。"
    },
    {
      "id": "vector",
      "title": "碑文·方向",
      "text": "有向的线段，藏着长度与夹角两种真相。"
    },
    {
      "id": "algebra",
      "title": "碑文·根基",
      "text": "一切推演，皆从数与式的根基生长。"
    }
  ]
